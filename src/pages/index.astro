---
import { site } from "../content/site";
import Layout from "../layouts/MainLayout.astro";
import Hero from "../components/home/Hero.astro";
---

<Layout title="ACSC Advogadas">
<section class="bg-white">

    <div class="mx-auto grid max-w-7xl gap-16 px-6 py-24 lg:grid-cols-2">
        <!-- Texto -->
        <div class="flex flex-col justify-center">

            <span class="mb-4 font-semibold uppercase tracking-widest text-blue-900">
                {site.name}
            </span>
            <h1 class="mb-6 text-5xl font-bold leading-tight lg:text-6xl">
                {site.slogan}
            </h1>
            <p class="mb-10 max-w-xl text-lg text-gray-600">
                {site.subtitulo}
            </p>
            <div class="flex flex-wrap gap-4">
                <a
                    href="#contato"
                    class="rounded-lg bg-blue-900 px-7 py-4 font-semibold text-white transition hover:bg-blue-800">
                    {site.botaoPrimario}
                </a>
                <a
                    href="#contato"
                    class="rounded-lg border border-blue-900 px-7 py-4 font-semibold text-blue-900 transition hover:bg-blue-50">
                    {site.botaoSecundario}
                </a>

            </div>

        </div>

        <!-- Imagem -->

        <div class="flex items-center justify-center">

            <div
                class="flex h-[500px] w-full items-center justify-center rounded-3xl border-2 border-dashed border-gray-300 bg-gray-100">

                Foto das Advogadas

            </div>

        </div>

    </div>

</section>
</Layout>