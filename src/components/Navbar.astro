---
import { site } from "../content/site";
---

<header class="border-b border-gray-200 bg-white">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">

        <!-- Logo -->
        <a href="/" class="text-2xl font-bold tracking-wide">
            {site.name}
        </a>

        <!-- Menu -->
        <nav class="hidden gap-8 md:flex">
            <a href="#sobre" class="transition hover:text-blue-700">
                {site.menu.sobre}
            </a>

            <a href="#areas" class="transition hover:text-blue-700">
                {site.menu.areas}
            </a>

            <a href="#contato" class="transition hover:text-blue-700">
                {site.menu.contato}
            </a>
        </nav>

        <!-- Botão -->
        <a
            href="#contato"
            class="rounded-lg bg-blue-900 px-5 py-3 text-white transition hover:bg-blue-800"
        >
            {site.botaoPrimario}
        </a>

    </div>
</header>