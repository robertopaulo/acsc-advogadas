---
import { site } from "../../content/site";
---

<section
    id="diferenciais"
    class="bg-[#3E2A21] py-20 text-white sm:py-24 lg:py-32"
>
    <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">

        <!-- Cabeçalho -->
        <div class="max-w-3xl">

            <p
                class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-[#C6A66B]"
            >
               {site.diferenciais.tituloPequeno}
            </p>

            <h2
                class="text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl"
            >
                {site.diferenciais.tituloBranco} 
                <span class="text-[#C6A66B]">
                    {site.diferenciais.tituloGold} 
                </span>
            </h2>

            <p
                class="mt-6 max-w-2xl text-base leading-7 text-white/70 sm:text-lg"
            >
                {site.diferenciais.paragrafo}
            </p>

        </div>


        <!-- Diferenciais -->
        <div
            class="mt-14 grid border-t border-white/15 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4"
        >

            {
                site.differentials.map((item) => (
                    <article
                        class="
                            group
                            border-b
                            border-white/15
                            py-8
                            sm:px-7
                            sm:nth-[2n+1]:border-r
                            lg:border-b-0
                            lg:border-r
                            lg:px-8
                            lg:last:border-r-0
                        "
                    >

                        <!-- Número -->
                        <span
                            class="
                                text-sm
                                font-semibold
                                tracking-[0.15em]
                                text-[#C6A66B]
                            "
                        >
                            {item.number}
                        </span>


                        <!-- Título -->
                        <h3
                            class="
                                mt-7
                                text-xl
                                font-semibold
                                transition-colors
                                duration-300
                                group-hover:text-[#C6A66B]
                            "
                        >
                            {item.title}
                        </h3>


                        <!-- Descrição -->
                        <p
                            class="
                                mt-4
                                text-sm
                                leading-6
                                text-white/65
                            "
                        >
                            {item.description}
                        </p>

                    </article>
                ))
            }

        </div>

    </div>
</section>