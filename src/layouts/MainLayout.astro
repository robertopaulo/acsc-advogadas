---
import '../styles/global.css'
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <title>{title}</title>
</head>

<body>

    <Navbar />

    <main>
        <slot />
    </main>

    <Footer />

</body>
</html>